    // MODAL VISOR DE DOCUMENTO
    function viewDoc(num) {
      var item = null;
      for (var i = 0; i < ACTS.length; i++) {
        if (ACTS[i].n === num) { item = ACTS[i]; break; }
      }
      if (!item) return;

      document.getElementById('doc-title').innerText = item.t;
      document.getElementById('doc-sub').innerText = item.f + " | Fecha: " + item.d;
      document.getElementById('doc-body').innerHTML = item.b;
      document.getElementById('modal-doc').style.display = 'flex';
    }

    function closeDocModal() {
      document.getElementById('modal-doc').style.display = 'none';
    }

    // TEMPORIZADOR DE 7 MINUTOS (420 SEGUNDOS)
    var timeLeft = 420;
    var timerInt = null;

    function startSessionTimer() {
      if (timerInt) clearInterval(timerInt);
      timeLeft = 420;
      updateTimer();
      timerInt = setInterval(function() {
        timeLeft--;
        updateTimer();
        if (timeLeft <= 0) {
          clearInterval(timerInt);
          document.getElementById('modal-timeout').style.display = 'flex';
        }
      }, 1000);
    }

    function resetTimer() {
      timeLeft = 420;
      updateTimer();
    }

    function updateTimer() {
      var m = Math.floor(timeLeft / 60);
      var s = timeLeft % 60;
      var str = (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
      var el = document.getElementById('session-timer');
      var bg = document.getElementById('session-badge');
      if (el) el.innerText = str;
      if (timeLeft <= 60 && bg) {
        bg.classList.add('timer-alert');
      } else if (bg) {
        bg.classList.remove('timer-alert');
      }
    }

    function forceRedirect() {
      document.getElementById('modal-timeout').style.display = 'none';
      document.getElementById('captcha-step').style.display = 'block';
      document.getElementById('form-step').style.display = 'none';
      cancelSearch();
      switchScreen('screen-0');
    }
  </script>
