    // CONTROL DE PANTALLAS
    function switchScreen(id) {
      var scs = document.querySelectorAll('.screen');
      for (var i = 0; i < scs.length; i++) {
        scs[i].classList.remove('active');
      }
      var target = document.getElementById(id);
      if (target) target.classList.add('active');
      window.scrollTo(0, 0);
    }

    // FLUJO PANTALLA 0 -> 1 -> 2
    function goToScreen1() {
      switchScreen('screen-1');
      startSessionTimer();
      var p = 0;
      var bar = document.getElementById('p1-bar');
      bar.style.width = '0%';
      var iv = setInterval(function() {
        p += 15;
        bar.style.width = p + '%';
        if (p >= 100) {
          clearInterval(iv);
          setTimeout(function() { switchScreen('screen-2'); }, 150);
        }
      }, 50);
    }

    // FLUJO PANTALLA 2 (PORTAL Y CAPTCHA)
    function showInfo(topic) {
      document.getElementById('temis-view').style.display = 'none';
      document.getElementById('search-view').style.display = 'none';
      var v = document.getElementById('info-view');
      v.style.display = 'block';

      var t = document.getElementById('info-title');
      var d = document.getElementById('info-desc');
      if (topic === 'inicio') {
        hideInfo();
      } else if (topic === 'mision') {
        t.innerText = "Misión Institucional";
        d.innerText = "Administrar Justicia a través de sus órganos jurisdiccionales, garantizando la seguridad jurídica, la tutela jurisdiccional efectiva y el debido proceso.";
      } else if (topic === 'vision') {
        t.innerText = "Visión del Poder Judicial";
        d.innerText = "Poder del Estado confiable, transparente y eficiente, con estándares digitales y servicio oportuno al justiciable.";
      } else if (topic === 'transparencia') {
        t.innerText = "Transparencia Judicial";
        d.innerText = "Portal de acceso público a presupuestos, personal judicial y contrataciones de la Corte Superior de Justicia de Puno.";
      } else {
        t.innerText = "Atención al Ciudadano";
        d.innerText = "Sede Central Juliaca: Jr. Apurímac / Pumacahua. Módulo Laboral: Jr. Mariano Núñez N° 139. Central Telefónica: (051) 507000.";
      }
    }

    function hideInfo() {
      document.getElementById('info-view').style.display = 'none';
      document.getElementById('search-view').style.display = 'none';
      document.getElementById('temis-view').style.display = 'block';
    }

    function activateSearch() {
      document.getElementById('temis-view').style.display = 'none';
      document.getElementById('info-view').style.display = 'none';
      document.getElementById('search-view').style.display = 'block';
      makeCaptcha();
    }

    function cancelSearch() {
      hideInfo();
    }

    var realCaptcha = "";
    function makeCaptcha() {
      var chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
      var code = "";
      for (var i = 0; i < 5; i++) {
        code += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      realCaptcha = code;
      document.getElementById('captcha-txt').innerText = code;
      document.getElementById('captcha-in').value = "";
      document.getElementById('captcha-err').style.display = 'none';
    }

    function checkCaptcha() {
      var userVal = document.getElementById('captcha-in').value.trim().toUpperCase();
      if (userVal === realCaptcha) {
        document.getElementById('captcha-step').style.display = 'none';
        document.getElementById('form-step').style.display = 'block';
      } else {
        document.getElementById('captcha-err').style.display = 'block';
        makeCaptcha();
      }
    }

    // FLUJO PANTALLA 2 -> 3 -> 4
    function goToScreen3() {
      switchScreen('screen-3');
      var p = 0;
      var bar = document.getElementById('p3-bar');
      bar.style.width = '0%';
      var iv = setInterval(function() {
        p += 15;
        bar.style.width = p + '%';
        if (p >= 100) {
          clearInterval(iv);
          setTimeout(function() {
            renderCase();
            switchScreen('screen-4');
          }, 150);
        }
      }, 50);
    }

    function returnToSearch() {
      switchScreen('screen-2');
      activateSearch();
    }

    // RENDERIZAR ACTUADOS Y MEDIOS DE PRUEBA
    function renderCase() {
      // 1. Tabla Desktop
      var dRows = document.getElementById('timeline-desktop-rows');
      dRows.innerHTML = '';
      for (var i = 0; i < ACTS.length; i++) {
        var a = ACTS[i];
        var tr = document.createElement('tr');
        tr.innerHTML = '<td style="text-align:center; font-weight:bold;">' + (a.n < 10 ? '0' + a.n : a.n) + '</td>' +
                       '<td style="font-family:monospace;">' + a.f + '</td>' +
                       '<td>' + a.d + '</td>' +
                       '<td style="font-weight:bold; color:#881337;">' + a.t + '</td>' +
                       '<td style="font-size:11px; color:#475569;">' + a.des + '</td>' +
                       '<td style="text-align:center;"><button onclick="viewDoc(' + a.n + ')" style="background:#881337; color:white; border:none; padding:4px 8px; border-radius:4px; font-size:11px; cursor:pointer;">Ver Fojas</button></td>';
