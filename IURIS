<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>CEJ - Expediente Judicial Electrónico | Poder Judicial del Perú</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & Merriweather -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body { font-family: 'Inter', sans-serif; }
    .font-judicial { font-family: 'Merriweather', serif; }
    .screen { display: none; }
    .screen.active { display: flex; }
    .progress-bar-fill { transition: width 0.1s linear; }
    @keyframes pulse-magenta {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.98); }
    }
    .timer-warning {
      animation: pulse-magenta 1s infinite;
      color: #f43f5e !important;
      border-color: #f43f5e !important;
      background-color: rgba(244, 63, 94, 0.15) !important;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-[#fdf2f8]/40 text-slate-800 antialiased min-h-screen flex flex-col justify-between selection:bg-pink-600 selection:text-white">

  <!-- AVISO ACADÉMICO SUPERIOR -->
  <div class="bg-gradient-to-r from-rose-900 via-pink-800 to-rose-950 text-pink-100 text-[10px] sm:text-xs font-semibold px-3 py-1.5 text-center flex items-center justify-center gap-1.5 shadow-sm border-b border-pink-700/60 sticky top-0 z-50">
    <i data-lucide="graduation-cap" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-pink-300 flex-shrink-0"></i>
    <span class="truncate tracking-wide">PORTAL ACADÉMICO UNIVERSITARIO - CSJ PUNO | EXPEDIENTE JUDICIAL ELECTRÓNICO (EJE)</span>
  </div>

  <!-- CONTENEDOR PRINCIPAL -->
  <main class="flex-grow flex flex-col w-full">

    <!-- ========================================== -->
    <!-- PANTALLA 0: BIENVENIDA                     -->
    <!-- ========================================== -->
    <section id="screen-0" class="screen active flex-grow flex-col items-center justify-center p-3 sm:p-6">
      <div class="max-w-xl w-full bg-white rounded-3xl shadow-2xl border border-pink-100 overflow-hidden my-auto">
        <div class="bg-gradient-to-br from-[#4c0519] via-[#881337] to-[#be185d] text-white p-7 sm:p-10 text-center relative overflow-hidden">
          <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-pink-500/20 rounded-full blur-2xl pointer-events-none"></div>
          <div class="w-20 h-20 mx-auto mb-4 bg-white/10 rounded-2xl flex items-center justify-center p-3.5 backdrop-blur-md ring-1 ring-white/30 shadow-inner">
            <i data-lucide="scale" class="w-12 h-12 text-pink-200"></i>
          </div>
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-white drop-shadow-sm">PODER JUDICIAL DEL PERÚ</h1>
          <p class="text-pink-200 font-medium text-xs sm:text-sm mt-1">Consulta de Expedientes Judiciales (CEJ / EJE)</p>
          <div class="inline-block mt-3 px-3.5 py-1 bg-white/15 backdrop-blur-sm rounded-full text-[11px] text-pink-100 font-medium border border-white/20">
            Corte Superior de Justicia de Puno – Sede Juliaca
          </div>
        </div>

        <div class="p-6 sm:p-8 space-y-5">
          <div class="bg-pink-50/70 border-l-4 border-[#be185d] p-4 rounded-r-xl">
            <h2 class="text-xs font-bold text-[#881337] uppercase tracking-wider mb-1">Módulo Digital de Consulta Jurisdiccional</h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Examine fojas digitalizadas, resoluciones emitidas, cédulas electrónicas SINOE y recaudos probatorios de la causa laboral admitida.
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-slate-600">
            <div class="flex items-center gap-2.5 bg-slate-50/90 p-3 rounded-xl border border-pink-100/60">
              <div class="p-1.5 rounded-lg bg-pink-100 text-pink-700">
                <i data-lucide="shield-check" class="w-4 h-4"></i>
              </div>
              <span>Validez probatoria con firma digital certificada.</span>
            </div>
            <div class="flex items-center gap-2.5 bg-slate-50/90 p-3 rounded-xl border border-pink-100/60">
              <div class="p-1.5 rounded-lg bg-pink-100 text-pink-700">
                <i data-lucide="clock" class="w-4 h-4"></i>
              </div>
              <span>Seguridad SINOE con sesión de 7 minutos.</span>
            </div>
          </div>

          <button onclick="goToScreen1()" class="w-full bg-gradient-to-r from-[#881337] via-[#9f1239] to-[#be185d] hover:brightness-110 text-white font-semibold py-3.5 px-6 rounded-xl shadow-lg shadow-pink-900/20 transition-all flex items-center justify-center gap-2 text-sm group">
            <span>Acceder al Expediente Electrónico</span>
            <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
          </button>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- PANTALLA 1: CARGA DE TRANSICIÓN AL PORTAL  -->
    <!-- ========================================== -->
    <section id="screen-1" class="screen flex-grow flex-col items-center justify-center p-4">
      <div class="max-w-xs sm:max-w-sm w-full text-center space-y-6">
        <div class="relative w-20 h-20 mx-auto">
          <div class="absolute inset-0 rounded-full border-4 border-pink-100"></div>
          <div class="absolute inset-0 rounded-full border-4 border-[#be185d] border-t-transparent animate-spin"></div>
          <div class="absolute inset-0 flex items-center justify-center">
            <i data-lucide="scale" class="w-8 h-8 text-[#9f1239] animate-pulse"></i>
          </div>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-900">Estableciendo Conexión Segura con el SIJ</h3>
          <p class="text-xs text-slate-500 mt-1">Corte Superior de Justicia de Puno</p>
        </div>
        <div class="w-full bg-pink-100/80 h-2 rounded-full overflow-hidden shadow-inner">
          <div id="p1-progress" class="bg-gradient-to-r from-[#881337] to-[#be185d] h-full w-0 progress-bar-fill"></div>
        </div>
        <p class="text-[11px] text-slate-400">Verificando certificados criptográficos y credenciales...</p>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- PANTALLA 2: PORTAL ESTATAL Y BÚSQUEDA       -->
    <!-- ========================================== -->
    <section id="screen-2" class="screen flex-grow flex-col">
      <!-- Cabecera Superior Estatal en Magenta Profundo -->
      <header class="bg-[#4c0519] text-white shadow-lg border-b border-pink-800">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 py-3 flex items-center justify-between gap-2">
          <div class="flex items-center gap-2.5">
            <div class="bg-white/10 p-2 rounded-xl flex-shrink-0 border border-white/10">
              <i data-lucide="landmark" class="w-5 h-5 text-pink-300"></i>
            </div>
            <div>
              <div class="text-[10px] font-bold text-pink-300 uppercase tracking-widest leading-none">PODER JUDICIAL DEL PERÚ</div>
              <div class="text-xs sm:text-base font-bold leading-tight truncate">CEJ Judicial Puno (Sede Juliaca)</div>
            </div>
