<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>CEJ - Expediente Judicial Electrónico | Poder Judicial del Perú</title>
  
  <!-- CSS Puro Embebido (Garantiza 100% de compatibilidad sin depender de CDNs) -->
  <style>
    :root {
      --magenta-darkest: #2e081d;
      --magenta-dark: #4c0519;
      --magenta-primary: #881337;
      --magenta-vivid: #be185d;
      --magenta-light: #fdf2f8;
      --magenta-border: #fbcfe8;
      --text-main: #1e293b;
      --text-muted: #64748b;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: var(--magenta-light);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* Regla crítica para cambio de pantallas */
    .screen {
      display: none !important;
      width: 100%;
      flex-grow: 1;
    }
    .screen.active {
      display: flex !important;
      flex-direction: column;
    }

    /* Barra académica superior */
    .top-academic-banner {
      background: linear-gradient(90deg, #4c0519, #881337, #4c0519);
      color: #fce7f3;
      font-size: 11px;
      font-weight: 700;
      padding: 6px 12px;
      text-align: center;
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid #be185d;
    }

    /* Pantalla 0 y 1 Centradas */
    .center-container {
      display: flex;
      flex-grow: 1;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }

    .card-box {
      background: #ffffff;
      border-radius: 20px;
      border: 1px solid var(--magenta-border);
      box-shadow: 0 10px 25px -5px rgba(136, 19, 55, 0.15);
      width: 100%;
      max-width: 600px;
      overflow: hidden;
    }

    .card-header-magenta {
      background: linear-gradient(135deg, #4c0519, #881337, #be185d);
      color: #ffffff;
      padding: 28px 20px;
      text-align: center;
    }

    .btn-magenta {
      background: linear-gradient(90deg, #881337, #be185d);
      color: #ffffff;
      border: none;
      padding: 12px 20px;
      border-radius: 10px;
      font-weight: 700;
      font-size: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      transition: opacity 0.2s;
    }
    .btn-magenta:hover { opacity: 0.95; }

    /* Barra Estatal y Navegación */
    .gov-header {
      background-color: var(--magenta-dark);
      color: #ffffff;
      padding: 10px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .gov-nav {
      background-color: var(--magenta-darkest);
      display: flex;
      overflow-x: auto;
      padding: 4px 12px;
      gap: 8px;
    }
    .gov-nav::-webkit-scrollbar { display: none; }

    .nav-btn {
      background: transparent;
      border: none;
      color: #fbcfe8;
      padding: 8px 12px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      border-bottom: 2px solid transparent;
    }
    .nav-btn.active, .nav-btn:hover {
      color: #ffffff;
      border-bottom-color: var(--magenta-vivid);
    }
    .btn-search-tab {
      margin-left: auto;
      background: #be185d;
      color: white;
      border-radius: 6px;
      padding: 6px 12px;
    }

    /* Cronómetro */
    .timer-badge {
      background: var(--magenta-darkest);
      border: 1px solid #881337;
      color: #fce7f3;
      padding: 4px 10px;
      border-radius: 8px;
      font-family: monospace;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .timer-alert {
      background: #e11d48 !important;
      color: #ffffff !important;
      animation: pulse 1s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    /* Grid y Contenedores */
    .content-area {
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
      padding: 16px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 16px;
      margin-top: 16px;
    }
    @media (max-width: 850px) {
      .grid-2 { grid-template-columns: 1fr; }
    }

    .white-card {
      background: #ffffff;
      border-radius: 14px;
      border: 1px solid var(--magenta-border);
      padding: 16px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.03);
    }

    .card-title {
      font-size: 13px;
      font-weight: 800;
      color: var(--magenta-primary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
      border-bottom: 1px solid #fce7f3;
      padding-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Tablas y Listas */
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    th {
      background: var(--magenta-dark);
      color: white;
      text-align: left;
      padding: 8px;
      font-weight: 600;
    }
    td {
      padding: 8px;
      border-bottom: 1px solid #fce7f3;
    }

    .mobile-act-card {
      display: none;
      background: #ffffff;
      border: 1px solid var(--magenta-border);
      padding: 12px;
      border-radius: 10px;
      margin-bottom: 8px;
    }
    @media (max-width: 768px) {
      .table-desktop { display: none; }
      .mobile-act-card { display: block; }
    }

    /* Modales */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(46, 8, 29, 0.7);
      backdrop-filter: blur(2px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 2000;
    }
    .modal-box {
      background: #ffffff;
      border-radius: 16px;
      max-width: 750px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      border: 1px solid var(--magenta-border);
    }

    /* Barras de progreso */
    .progress-track {
      background: #fce7f3;
      height: 8px;
      border-radius: 10px;
      overflow: hidden;
      width: 100%;
      margin: 15px 0;
    }
    .progress-bar {
      height: 100%;
      background: linear-gradient(90deg, #881337, #be185d);
      width: 0%;
      transition: width 0.1s linear;
    }
  </style>
</head>
<body>

  <!-- BANNER ACADÉMICO -->
  <div class="top-academic-banner">
    PORTAL DIDÁCTICO ACADÉMICO - CORTE SUPERIOR DE JUSTICIA DE PUNO (EXPEDIENTE EJE)
  </div>

  <main style="flex-grow: 1; display: flex; flex-direction: column;">

    <!-- ========================================== -->
    <!-- PANTALLA 0: BIENVENIDA                     -->
    <!-- ========================================== -->
    <section id="screen-0" class="screen active center-container">
      <div class="card-box">
        <div class="card-header-magenta">
          <svg style="width: 48px; height: 48px; margin-bottom: 8px;" viewBox="0 0 24 24" fill="none" stroke="#fbcfe8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>
          </svg>
          <h1 style="font-size: 20px; font-weight: 800;">PODER JUDICIAL DEL PERÚ</h1>
          <p style="font-size: 13px; color: #fce7f3; margin-top: 4px;">Consulta de Expedientes Judiciales (CEJ / EJE)</p>
          <span style="font-size: 11px; background: rgba(255,255,255,0.2); padding: 2px 10px; border-radius: 20px; margin-top: 8px; display: inline-block;">
            Distrito Judicial de Puno – Sede Juliaca
          </span>
        </div>

        <div style="padding: 24px;">
          <div style="background: #fdf2f8; border-left: 4px solid #be185d; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
            <p style="font-size: 12px; color: #4c0519; line-height: 1.5;">
              Acceso institucional para cátedra universitaria. Permite revisar el cuaderno laboral digitalizado, autos resolutivos y medios probatorios en tiempo real.
            </p>
          </div>

          <button onclick="goToScreen1()" class="btn-magenta">
            <span>Ingresar al Sistema Jurisdiccional</span>
            <svg style="width: 16px; height: 16px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- PANTALLA 1: CARGA AL PORTAL                -->
    <!-- ========================================== -->
    <section id="screen-1" class="screen center-container">
      <div style="max-w: 380px; width: 100%; text-align: center;">
        <svg style="width: 44px; height: 44px; color: #881337; margin-bottom: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
        </svg>
        <h3 style="font-size: 16px; font-weight: 700; color: #4c0519;">Conectando con la Sede Juliaca</h3>
        <p style="font-size: 12px; color: #64748b; margin-top: 4px;">Validando credenciales en el Sistema Integrado Judicial (SIJ)...</p>
        <div class="progress-track">
          <div id="p1-bar" class="progress-bar"></div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- PANTALLA 2: PORTAL ESTATAL Y BÚSQUEDA       -->
    <!-- ========================================== -->
    <section id="screen-2" class="screen">
      <!-- Cabecera Institucional -->
      <div class="gov-header">
        <div style="display: flex; align-items: center; gap: 8px;">
          <svg style="width: 22px; height: 22px; color: #fbcfe8;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 10v11"/><path d="M19 10v11"/><path d="M9 10v11"/><path d="M15 10v11"/><path d="M12 2 2 7h20L12 2z"/></svg>
          <div>
            <div style="font-size: 9px; font-weight: 800; color: #fbcfe8; letter-spacing: 1px;">PODER JUDICIAL DEL PERÚ</div>
            <div style="font-size: 13px; font-weight: 700;">CEJ Electrónico Puno</div>
          </div>
        </div>

        <div style="display: flex; align-items: center; gap: 8px;">
          <div id="session-badge" class="timer-badge">
            <span style="font-size: 11px;">Sesión:</span>
            <strong id="session-timer">07:00</strong>
          </div>
          <button onclick="resetTimer()" style="background: none; border: 1px solid #881337; color: white; padding: 4px 8px; border-radius: 6px; cursor: pointer;">↻</button>
        </div>
      </div>

      <!-- Menú de Navegación -->
      <div class="gov-nav">
        <button onclick="showInfo('inicio')" class="nav-btn active">Inicio</button>
        <button onclick="showInfo('mision')" class="nav-btn">Misión</button>
        <button onclick="showInfo('vision')" class="nav-btn">Visión</button>
        <button onclick="showInfo('transparencia')" class="nav-btn">Transparencia</button>
        <button onclick="showInfo('contactanos')" class="nav-btn">Contáctanos</button>
        <button onclick="activateSearch()" class="nav-btn btn-search-tab">🔍 Búsqueda de Expedientes</button>
      </div>

      <!-- Área de Contenido Central -->
      <div class="content-area" style="flex-grow: 1; display: flex; flex-direction: column; justify-content: center;">
        
        <!-- VISTA POR DEFECTO: ILUSTRACIÓN DE TEMIS -->
        <div id="temis-view" class="white-card" style="text-align: center; padding: 36px 16px;">
          <svg style="width: 140px; height: 140px; margin: 0 auto 12px; display: block;" viewBox="0 0 200 200" fill="none">
            <circle cx="100" cy="100" r="90" fill="#fdf2f8" stroke="#be185d" stroke-width="3" stroke-dasharray="4 2"/>
            <path d="M100 25 L100 160" stroke="#881337" stroke-width="4" stroke-linecap="round"/>
            <path d="M80 160 L120 160" stroke="#881337" stroke-width="6" stroke-linecap="round"/>
            <path d="M50 55 L150 55" stroke="#be185d" stroke-width="4" stroke-linecap="round"/>
            <circle cx="100" cy="55" r="6" fill="#881337"/>
            <path d="M50 55 L35 95" stroke="#9f1239" stroke-width="2"/><path d="M50 55 L65 95" stroke="#9f1239" stroke-width="2"/>
            <path d="M25 95 Q50 115 75 95 Z" fill="#fbcfe8"/>
            <path d="M150 55 L135 95" stroke="#9f1239" stroke-width="2"/><path d="M150 55 L165 95" stroke="#9f1239" stroke-width="2"/>
            <path d="M125 95 Q150 115 175 95 Z" fill="#fbcfe8"/>
            <path d="M85 40 Q100 35 115 40" stroke="#4c0519" stroke-width="3"/>
          </svg>
          <h2 style="font-size: 18px; color: #4c0519; font-weight: 800;">Jurisdicción Laboral - Distrito Judicial Puno</h2>
          <p style="font-size: 13px; color: #64748b; max-width: 440px; margin: 8px auto 16px;">
            Haga clic en el botón superior o en el acceso rápido para desplegar el formulario con CAPTCHA y consultar la causa.
          </p>
          <button onclick="activateSearch()" class="btn-magenta" style="max-width: 250px; margin: 0 auto;">
            Consultar Expediente
          </button>
        </div>

        <!-- VISTA DE INFORMACIÓN INSTITUCIONAL -->
        <div id="info-view" class="white-card" style="display: none;">
          <h3 id="info-title" style="color: var(--magenta-primary); margin-bottom: 8px; font-size: 16px;"></h3>
          <p id="info-desc" style="font-size: 13px; color: #475569; line-height: 1.6;"></p>
          <button onclick="hideInfo()" style="margin-top: 12px; background: #e2e8f0; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12px;">Volver</button>
        </div>

        <!-- VISTA DE FORMULARIO CON CAPTCHA -->
        <div id="search-view" class="white-card" style="display: none; max-width: 650px; margin: 0 auto; width: 100%;">
          <div style="background: #4c0519; color: white; padding: 12px; border-radius: 8px 8px 0 0; margin: -16px -16px 16px; display: flex; justify-content: space-between;">
            <strong style="font-size: 13px;">Búsqueda de Causas Judiciales</strong>
            <button onclick="cancelSearch()" style="background: none; border: none; color: #fbcfe8; cursor: pointer;">✕</button>
          </div>

          <!-- PASO 1: CAPTCHA -->
          <div id="captcha-step">
            <div style="background: #fdf2f8; border: 1px solid #fbcfe8; padding: 10px; border-radius: 8px; font-size: 12px; color: #881337; margin-bottom: 12px;">
              Seguridad judicial: Ingrese el código alfanumérico para desbloquear los datos del expediente.
            </div>
            <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px;">
              <div id="captcha-txt" style="background: #2e081d; color: #fbcfe8; font-family: monospace; font-size: 22px; font-weight: 800; letter-spacing: 5px; padding: 8px 16px; border-radius: 8px; text-decoration: line-through;">
                7B8K2
              </div>
              <button onclick="makeCaptcha()" style="padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; cursor: pointer; background: white;">↻</button>
              <input type="text" id="captcha-in" placeholder="Código" style="flex-grow: 1; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; text-transform: uppercase; font-weight: bold;">
            </div>
            <button onclick="checkCaptcha()" class="btn-magenta">Validar Código</button>
            <div id="captcha-err" style="display: none; color: #e11d48; font-size: 12px; margin-top: 6px; text-align: center;">Código incorrecto. Vuelva a intentarlo.</div>
          </div>

          <!-- PASO 2: FORMULARIO -->
          <div id="form-step" style="display: none;">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; margin-bottom: 12px;">
              <div>
                <label style="font-size: 11px; font-weight: bold; color: #64748b;">Correlativo</label>
                <input type="text" id="in-exp" value="00174" style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
              </div>
              <div>
                <label style="font-size: 11px; font-weight: bold; color: #64748b;">Año</label>
                <input type="text" value="2019" style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
              </div>
              <div>
                <label style="font-size: 11px; font-weight: bold; color: #64748b;">Cuaderno</label>
                <input type="text" value="0" style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
              </div>
              <div>
                <label style="font-size: 11px; font-weight: bold; color: #64748b;">Distrito</label>
                <input type="text" value="2111" style="width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
              </div>
            </div>

            <div style="background: #fdf2f8; border: 1px solid #fbcfe8; padding: 8px 12px; border-radius: 6px; font-size: 12px; margin-bottom: 12px;">
              Caso de estudio listo: <strong>00174-2019-0-2111-JR-LA-02</strong> (Supo Quispe vs EsSalud)
            </div>

            <button onclick="goToScreen3()" class="btn-magenta">
              Consultar Expediente Electrónico
            </button>
          </div>
        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- PANTALLA 3: CARGA DE CONSULTA A BASE SIJ   -->
    <!-- ========================================== -->
    <section id="screen-3" class="screen center-container">
      <div style="max-width: 380px; width: 100%; text-align: center;">
        <svg style="width: 44px; height: 44px; color: #be185d; margin-bottom: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/>
        </svg>
        <h3 style="font-size: 16px; font-weight: 700; color: #4c0519;">Indexando Expediente Electrónico</h3>
        <p style="font-size: 12px; color: #64748b; margin-top: 4px;">Recuperando foliatura, resoluciones y pruebas...</p>
        <div class="progress-track">
          <div id="p3-bar" class="progress-bar"></div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- PANTALLA 4: VISOR INTEGRAL DEL EXPEDIENTE  -->
    <!-- ========================================== -->
    <section id="screen-4" class="screen">
      <!-- Barra Superior del Expediente -->
      <div style="background: #4c0519; color: white; padding: 12px 16px; border-bottom: 2px solid #be185d;">
        <div class="content-area" style="padding: 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
          <div>
            <div style="font-size: 10px; color: #fbcfe8; font-weight: 700;">EXPEDIENTE JUDICIAL ELECTRÓNICO (EJE)</div>
            <div style="font-size: 16px; font-weight: 800; font-family: monospace;">00174-2019-0-2111-JR-LA-02</div>
          </div>
          <button onclick="returnToSearch()" style="background: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: white; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12px;">
            ← Nueva Búsqueda
          </button>
        </div>
      </div>

      <div class="content-area" style="padding-top: 16px; padding-bottom: 24px;">
        
        <!-- Ficha Técnica -->
        <div class="white-card">
          <div class="card-title">1. Ficha Técnica General</div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; font-size: 12px;">
            <div><span style="color: #64748b; display: block;">Distrito / Sede:</span> <strong>Puno / San Román – Juliaca</strong></div>
            <div><span style="color: #64748b; display: block;">Juzgado:</span> <strong>Juzgado de Trabajo – Zona Norte</strong></div>
            <div><span style="color: #64748b; display: block;">Juez:</span> <strong>Huamán Romero, Gonzalo Víctor</strong></div>
            <div><span style="color: #64748b; display: block;">Secretaria:</span> <strong>Carlos Villán, Rosario</strong></div>
            <div><span style="color: #64748b; display: block;">Ingreso:</span> <strong>26/06/2019 – 11:31:38</strong></div>
            <div><span style="color: #64748b; display: block;">Materia:</span> <strong style="color: #881337;">Desnaturalización de Contrato (Ley 26636)</strong></div>
          </div>
        </div>

        <!-- Partes Procesales y Pretensión -->
        <div class="grid-2">
          <div class="white-card">
            <div class="card-title">2. Sujetos Procesales</div>
            <div style="display: flex; flex-direction: column; gap: 8px; font-size: 12px;">
              <div style="background: #fdf2f8; border: 1px solid #fbcfe8; padding: 8px; border-radius: 6px;">
                <span style="color: #be185d; font-weight: 800; font-size: 10px;">DEMANDANTE (DNI 02167445)</span>
                <div style="font-weight: bold;">Andrés Leonidas Supo Quispe</div>
                <div style="font-size: 11px; color: #64748b;">Abog. Lino Larico (Reg. CAP 47) | SINOE: 60375</div>
              </div>
              <div style="background: #fff1f2; border: 1px solid #fecdd3; padding: 8px; border-radius: 6px;">
                <span style="color: #e11d48; font-weight: 800; font-size: 10px;">DEMANDADA (RUC 20131257750)</span>
                <div style="font-weight: bold;">EsSalud Red Asistencial Juliaca</div>
                <div style="font-size: 11px; color: #64748b;">Apoderado: Hernán López Alférez | SINOE: 59629</div>
              </div>
              <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 8px; border-radius: 6px; font-size: 11px;">
                <strong>Tercero:</strong> Servicios Integrados de Limpieza S.A. – SILSA (RUC 20100362598)
              </div>
            </div>
          </div>

          <div class="white-card">
            <div class="card-title">3. Petitorio</div>
